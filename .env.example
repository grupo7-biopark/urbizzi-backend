# Ambiente da aplicação: development | production | test (padrão: development)
NODE_ENV=development

# Porta HTTP da API (padrão: 3000)
PORT=3000

# Credenciais do Postgres usadas pelo docker-compose
POSTGRES_USER=urbizzi
POSTGRES_PASSWORD=urbizzi
POSTGRES_DB=urbizzi
# Porta do Postgres exposta no host (padrão: 5432)
POSTGRES_PORT=5432

# [OBRIGATÓRIA] URL de conexão do Prisma.
# Use "localhost" ao rodar a API fora do Docker (npm run start:dev, testes).
# Dentro do docker-compose esse valor é sobrescrito para apontar ao serviço "postgres".
DATABASE_URL=postgresql://urbizzi:urbizzi@localhost:5432/urbizzi?schema=public

# Garage/S3: credenciais abaixo são fictícias, exclusivas do ambiente local.
# Configure credenciais próprias no deploy; a aplicação não define segredos padrão.
S3_ENDPOINT=http://localhost:3900
# Endereço acessível ao destinatário das URLs assinadas (pode diferir do endpoint interno).
S3_PUBLIC_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=GK0123456789abcdef0123456789abcdef
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET_ORIGINAIS=plantas-originais
S3_BUCKET_TILES=plantas-tiles
# Validade padrão de URL assinada em segundos: 1 a 604800.
S3_URL_EXPIRES_IN=900
# Apenas para o Garage local: segredo RPC hexadecimal de 32 bytes e porta S3 no host.
GARAGE_RPC_SECRET=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
GARAGE_S3_PORT=3900
