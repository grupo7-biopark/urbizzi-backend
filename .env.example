# Ambiente da aplicação: development | production | test (padrão: development)
NODE_ENV=development

# Porta HTTP da API (padrão: 3000)
PORT=3000

# Credenciais do Postgres usadas pelo docker-compose
POSTGRES_USER=urbizzi
POSTGRES_PASSWORD=urbizzi
POSTGRES_DB=urbizzi
# Porta do Postgres exposta no host (padrão: 5432)
POSTGRES_PORT=5432

# [OBRIGATÓRIA] URL de conexão do Prisma.
# Use "localhost" ao rodar a API fora do Docker (npm run start:dev, testes).
# Dentro do docker-compose esse valor é sobrescrito para apontar ao serviço "postgres".
DATABASE_URL=postgresql://urbizzi:urbizzi@localhost:5432/urbizzi?schema=public
