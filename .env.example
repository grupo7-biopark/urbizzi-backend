# Ambiente da aplicação: development | production | test (padrão: development)
NODE_ENV=development

# Porta HTTP da API (padrão: 3000)
PORT=3000

# Credenciais do Postgres usadas pelo docker-compose
POSTGRES_USER=urbizzi
POSTGRES_PASSWORD=urbizzi
POSTGRES_DB=urbizzi
# Porta do Postgres exposta no host (padrão: 5432)
POSTGRES_PORT=5432

# [OBRIGATÓRIA] URL de conexão do Prisma.
# Use "localhost" ao rodar a API fora do Docker (npm run start:dev, testes).
# Dentro do docker-compose esse valor é sobrescrito para apontar ao serviço "postgres".
DATABASE_URL=postgresql://urbizzi:urbizzi@localhost:5432/urbizzi?schema=public

# Garage/S3: credenciais abaixo são fictícias, exclusivas do ambiente local.
# Configure credenciais próprias no deploy; a aplicação não define segredos padrão.
S3_ENDPOINT=http://localhost:3900
# Endereço acessível ao destinatário das URLs assinadas (pode diferir do endpoint interno).
S3_PUBLIC_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=GK0123456789abcdef0123456789abcdef
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET_ORIGINAIS=plantas-originais
S3_BUCKET_TILES=plantas-tiles
# Validade padrão de URL assinada em segundos: 1 a 604800.
S3_URL_EXPIRES_IN=900

# Processamento da planta em tiles (BE-31): worker da fila no próprio processo
# da API. Desative em instâncias que não devem processar.
PLANTAS_PROCESSAMENTO_ATIVO=true
# Intervalo, em ms, entre as consultas à fila quando ela está vazia
PLANTAS_FILA_INTERVALO_MS=5000
# Apenas para o Garage local: segredo RPC hexadecimal de 32 bytes e porta S3 no host.
GARAGE_RPC_SECRET=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
GARAGE_S3_PORT=3900
# [OBRIGATÓRIA] Gere um segredo aleatório com pelo menos 32 caracteres.
# Valor fictício apenas para desenvolvimento; substitua antes de publicar.
JWT_SECRET=exemplo-local-substitua-por-segredo-aleatorio
# Validade em segundos (60 a 3600); padrão de 15 minutos.
JWT_EXPIRES_IN=900
# Validade do refresh em segundos (3600 a 2592000); padrão de 7 dias.
REFRESH_TOKEN_EXPIRES_IN=604800

# E-mail: Mailpit local (interface em http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=nao-responda@urbizzi.local
# Configure autenticação no provedor SMTP de produção.
# SMTP_USER=
# SMTP_PASSWORD=
# Página do frontend que recebe ?token=... (não usa o Host da requisição).
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Canal comercial geral publicado no mapa; exemplo fictício. Sem configuração, orienta falar com quem compartilhou o link.
PUBLICO_CONTATO_COMERCIAL=https://exemplo.com/atendimento

# BE-05: usados somente pelos comandos de seed, não pela inicialização da API.
# Configure uma senha própria (8 a 1024 caracteres); não há senha padrão.
SEED_ADMIN_NOME=Administrador
SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_SENHA=
# Apenas db:seed:dev, com NODE_ENV=development; senha dos usuários fictícios.
SEED_DEV_SENHA=
